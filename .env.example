# Copy to .env and adjust. docker compose reads .env automatically.
# Only variables for services that exist so far are listed here.

# --- API gateway ---
GATEWAY_PORT=8000
# Signs login tokens; at least 32 characters. Generate one with: openssl rand -hex 32
JWT_SECRET=local-development-only-secret-do-not-use-elsewhere

# --- PostgreSQL (catalog) ---
CATALOG_DB_USER=catalog
CATALOG_DB_PASSWORD=catalog
CATALOG_DB_NAME=catalog_db

# --- Catalog service ---
CATALOG_PORT=8001

# --- Cart service (its Redis needs no settings) ---
CART_PORT=8002

# --- PostgreSQL (inventory) ---
INVENTORY_DB_USER=inventory
INVENTORY_DB_PASSWORD=inventory
INVENTORY_DB_NAME=inventory_db

# --- Inventory service ---
INVENTORY_PORT=8003

# --- PostgreSQL (order) ---
ORDER_DB_USER=order
ORDER_DB_PASSWORD=order
ORDER_DB_NAME=order_db

# --- Order service ---
ORDER_PORT=8004

# --- RabbitMQ (message broker, step 4) ---
RABBITMQ_USER=chapter-one
RABBITMQ_PASSWORD=chapter-one
# Web dashboard: http://localhost:15672
RABBITMQ_DASHBOARD_PORT=15672

LOG_LEVEL=INFO
