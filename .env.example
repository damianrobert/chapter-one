# Copy to .env and adjust. docker compose reads .env automatically.
# Only variables for services that exist so far are listed here.

# --- API gateway ---
GATEWAY_PORT=8000
# Signs login tokens; at least 32 characters. Generate one with: openssl rand -hex 32
JWT_SECRET=local-development-only-secret-do-not-use-elsewhere

# --- PostgreSQL (catalog) ---
CATALOG_DB_USER=catalog
CATALOG_DB_PASSWORD=catalog
CATALOG_DB_NAME=catalog_db

# --- Catalog service ---
CATALOG_PORT=8001

# --- Cart service (its Redis needs no settings) ---
CART_PORT=8002

LOG_LEVEL=INFO
